+# ClearCut security profile: media formats covered by the current FFmpeg
+# advisories are deliberately unavailable in the shipped Android build.
+# Keep this list explicit so the configure transcript and the native lock can
+# be compared during release review.
+CONFIGURE_POSTFIX+=" --disable-demuxer=vobsub"
+CONFIGURE_POSTFIX+=" --disable-decoder=tdsc"
+CONFIGURE_POSTFIX+=" --disable-decoder=mace6"
+CONFIGURE_POSTFIX+=" --disable-decoder=adpcm_adx"
+CONFIGURE_POSTFIX+=" --disable-demuxer=adx"
+CONFIGURE_POSTFIX+=" --disable-demuxer=aax"
+CONFIGURE_POSTFIX+=" --disable-encoder=png"
+CONFIGURE_POSTFIX+=" --disable-encoder=apng"
+CONFIGURE_POSTFIX+=" --disable-decoder=rasc"
+CONFIGURE_POSTFIX+=" --disable-demuxer=iamf"
+CONFIGURE_POSTFIX+=" --disable-decoder=zlib"
+
